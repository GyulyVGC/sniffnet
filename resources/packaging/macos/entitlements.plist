<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Used by the Mach-O launcher (the CFBundleExecutable when this app is
      signed) so it can send Apple Events to osascript. That is how the
      existing wrapper.sh asks for administrator privileges, which Sniffnet
      needs in order to open BPF devices via libpcap.

      The app is not sandboxed. Packet capture does not require a special
      entitlement when running as root outside the App Sandbox; the hardened
      runtime is enabled at codesign time with --options runtime.
    -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
